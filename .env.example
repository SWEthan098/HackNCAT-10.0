# Environment variables for HackNCAT. Placeholders only: never commit real secrets.
#
#   API  (FastAPI):  cp .env.example api/.env   then fill in the API section.
#                    Production: set the same keys in Railway -> service -> Variables.
#   Web  (Next.js):  web/.env is committed with the project's PUBLIC values. To override
#                    locally, create web/.env.local. Production: set them in Vercel.
#
# Find Supabase values in: Project Settings -> API Keys, and Project Settings -> Data API.

# ======================= web (public, shipped to every browser) =======================
# Safe to expose only because Row Level Security protects every table.
NEXT_PUBLIC_SUPABASE_URL=https://lyzkuyaetnlbvmwudskk.supabase.co
# The anon key or the newer publishable key (sb_publishable_...). Never the secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qs9bA--VZiv_WgmYPkf5nQ_p6vmJnKU
# FastAPI base URL, no trailing slash. Local: http://localhost:8000. Prod: your Railway URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ======================= api (secret, server only) =======================
# Never prefix these with NEXT_PUBLIC_ and never put them in web/.

# development | production. production turns Swagger off (unless ENABLE_DOCS=true).
ENVIRONMENT=development
# Optional: force Swagger on/off. Default: on in development, off in production.
ENABLE_DOCS=
# DEBUG | INFO | WARNING | ERROR. Logs never include tokens, passwords or prompts.
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API (CORS). Exact match, no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

SUPABASE_URL=https://lyzkuyaetnlbvmwudskk.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Bypasses RLS: server only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only for projects on the legacy HS256 JWT secret. This project uses asymmetric signing
# keys (ES256), so leave it empty: tokens are verified against SUPABASE_URL's JWKS.
SUPABASE_JWT_SECRET=

# ---------- AI (see docs/AI.md) ----------
# groq | anthropic | mock   (mock = offline, deterministic, no key needed)
AI_PROVIDER=groq
# Model id for the selected provider. Empty = provider default
# (groq: openai/gpt-oss-120b; others: openai/gpt-oss-20b, qwen/qwen3.8-27b; anthropic: claude-opus-5-5).
AI_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Anthropic thinking effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
AI_TIMEOUT_SECONDS=30
# SDK retries on 408/409/429/5xx with backoff (0-5)
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=1024
# Optional USD prices per million tokens, for cost estimates on models without a built-in
# price (e.g. Groq). Leave empty to report cost as unknown.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
