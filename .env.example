# Copy the relevant section into web/.env.local and api/.env for local dev.
# Never commit real values. Find them in Supabase: Project Settings -> API / API Keys / JWT Keys.

# ---------- web/.env.local (also set in Vercel) ----------
# Public values, shipped to the browser. Safe only because RLS protects every table.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Legacy "anon" key, or the newer "publishable" key (sb_publishable_...). Both work here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# FastAPI base URL, no trailing slash. Local: http://localhost:8000. Prod: your Railway URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- api/.env (also set in Railway) ----------
# Secret values. Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role (or sb_secret_...) key. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Legacy JWT secret (HS256). Leave empty if the project uses asymmetric JWT signing keys;
# the API then verifies tokens against SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=your-jwt-secret
# Comma-separated origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
